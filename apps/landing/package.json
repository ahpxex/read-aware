{
  "name": "@read-aware/landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run docs:check && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && bun scripts/prerender.mjs && tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "preview": "vite preview",
    "preview:worker": "bun run build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p scripts && tsc --noEmit -p tests",
    "test": "bun run test:static",
    "test:static": "bun test tests",
    "docs:generate": "bun scripts/plugin-reference.ts",
    "docs:check": "bun scripts/plugin-reference.ts --check && bun test tests/plugin-docs.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@read-aware/core": "workspace:*",
    "@read-aware/ui": "workspace:*",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/react-router": "^1.170.46",
    "@uiw/react-codemirror": "^4.25.12",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.5.11",
    "jotai": "^2.20.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "1.3.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "wrangler": "^4.155.0"
  }
}
