{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "read-aware-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // The landing build prerenders every concrete route into dist/<path>/index.html.
  // Keep the trailing-slash behavior aligned with its canonical URLs and sitemap.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/site-events"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [{ "binding": "SITE_ANALYTICS", "dataset": "readaware_site_events" }],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "readaware.app", "custom_domain": true }]
}
