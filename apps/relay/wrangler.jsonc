{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-aware-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // 自定义域：zone（readaware.app）在同一账号，部署时自动配 DNS + 证书。
  "routes": [{ "pattern": "relay.readaware.app", "custom_domain": true }],
  // 三个存储件（docs/sync-engine.md §4）：D1 = 账号/令牌/会话，
  // DO(SQLite) = 每账号一个编号密文邮筒，R2 = 加密 blob。
  // database_id 在首次部署前用 `wrangler d1 create read-aware-relay` 生成后填入。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "read-aware-relay",
      "database_id": "11be8edc-7568-492b-9930-8584db0cfa5c",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "AccountMailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountMailbox"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "read-aware-relay-blobs" }],
  "vars": {
    // 生产绝不能开 MAGIC_LINK_ECHO（等于任何人可冒充任何邮箱）；
    // 本地开发的回显由 `bun run dev` 脚本以 --var 注入。
    // 邮件链路（可选）：`wrangler secret put RESEND_API_KEY` + 此处 MAIL_FROM。
    // OAuth：`wrangler secret put GOOGLE_CLIENT_ID/SECRET、GITHUB_CLIENT_ID/SECRET`。
    "APP_ORIGIN": "https://readaware.app"
  }
}
