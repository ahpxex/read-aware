{
  "name": "@read-aware/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:foliate": "bun scripts/build-foliate.ts",
    "check:foliate": "bun scripts/build-foliate.ts --check",
    "watch:foliate": "bun scripts/build-foliate.ts --watch",
    "dev": "bun run build:foliate && concurrently --kill-others --names foliate,vite --passthrough-arguments \"bun run watch:foliate\" \"vite dev {@}\" --",
    "build": "bun run build:foliate && vite build && bun scripts/check-engine-compat.ts && tsc --noEmit",
    "test": "bun run build:foliate && bun test",
    "preview": "vite preview",
    "typecheck": "bun run check:foliate && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p scripts && bun run typecheck:tests && bun run typecheck:desktop && tsc --noEmit -p .storybook",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "typecheck:desktop": "tsc --noEmit -p tests/desktop/tsconfig.json",
    "test:runtime": "bun scripts/run-runtime-regressions.ts",
    "test:desktop-contracts": "bun test tests/desktop-location.test.ts src/features/plugins/runtime/plugin-sandbox.integration.test.ts",
    "storybook": "bun run build:foliate && concurrently --kill-others --names foliate,storybook --passthrough-arguments \"bun run watch:foliate\" \"storybook dev -p 6006 {@}\" --",
    "build-storybook": "bun run build:foliate && storybook build",
    "i18n:extract": "i18next -c i18next-parser.config.js",
    "lint:deps": "bun ../../scripts/check-dependency-baseline.ts",
    "lint:deps:baseline": "bun ../../scripts/check-dependency-baseline.ts --update",
    "vendor:fflate": "bun scripts/vendor-fflate.ts",
    "check:engine": "bun scripts/check-engine-compat.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@read-aware/agent": "workspace:*",
    "@read-aware/core": "workspace:*",
    "@read-aware/plugin-types": "workspace:*",
    "@read-aware/ui": "workspace:*",
    "@streamdown/cjk": "1.0.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "i18next": "^26.5.11",
    "i18next-resources-to-backend": "^1.2.3",
    "jotai": "^2.20.3",
    "libarchive.js": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "recharts": "^3.10.1",
    "semver": "^7.8.5",
    "streamdown": "^2.7.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "1.3.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.7.0",
    "fflate": "0.8.3",
    "i18next-parser": "^9.4.0",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.5.207",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7"
  }
}
