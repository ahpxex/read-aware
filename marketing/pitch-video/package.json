{
  "name": "@read-aware/pitch-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "bun run score && remotion studio",
    "score": "bun scripts/compose-score.ts",
    "render": "bun run score && remotion render Pitch out/readaware-pitch.mp4",
    "still": "remotion still Pitch --scale=0.5",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@read-aware/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.8.3"
  }
}
