{
  "name": "read-aware",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "marketing/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@read-aware/desktop",
    "dev:web": "turbo run dev --filter=@read-aware/web",
    "dev:landing": "turbo run dev --filter=@read-aware/landing",
    "build": "turbo run build --filter=@read-aware/web",
    "build:desktop": "turbo run build --filter=@read-aware/desktop",
    "build:landing": "turbo run build --filter=@read-aware/landing",
    "check:marketplace": "bun scripts/check-marketplace-contract.ts",
    "check:capabilities": "bun scripts/check-capabilities.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "ci": "bun install --frozen-lockfile && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run lint:deps && bun run check:docs && git diff --exit-code",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && bun run typecheck:repo",
    "typecheck:repo": "tsc --noEmit -p scripts && tsc --noEmit -p docs/capabilities",
    "eval:agent": "bun packages/agent/src/eval-run.ts",
    "eval:all": "bun packages/agent/src/eval-all-run.ts",
    "eval:rescore": "bun packages/agent/src/eval-rescore-run.ts",
    "eval:review": "bun packages/agent/src/eval-review-run.ts",
    "eval:digests": "bun packages/agent/src/eval-digests-run.ts",
    "eval:classify": "bun packages/agent/src/eval-classify-run.ts",
    "eval:reading": "bun packages/agent/src/eval-run.ts reading",
    "eval:behavior": "bun packages/agent/src/eval-run.ts behavior",
    "eval:realbook": "bun packages/agent/src/eval-run.ts realbook",
    "translate": "bun packages/agent/src/translate-run.ts",
    "storybook": "turbo run storybook --filter=@read-aware/web",
    "build-storybook": "turbo run build-storybook --filter=@read-aware/web",
    "lint": "oxlint && bun scripts/check-swallowed-rejections.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:deps": "turbo run lint:deps",
    "eval:ui": "bun --filter @read-aware/agent eval:ui"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.3.13",
    "dts-bundle-generator": "9.5.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "~5.8.3"
  },
  "patchedDependencies": {
    "mdast-util-gfm-autolink-literal@2.0.1": "patches/mdast-util-gfm-autolink-literal@2.0.1.patch",
    "openai@6.40.0": "patches/openai@6.40.0.patch",
    "@anthropic-ai/sdk@0.123.0": "patches/@anthropic-ai%2Fsdk@0.123.0.patch",
    "@earendil-works/pi-ai@0.85.1": "patches/@earendil-works%2Fpi-ai@0.85.1.patch"
  }
}
