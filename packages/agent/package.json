{
  "name": "@read-aware/agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./spike": "./src/spike.ts",
    "./evals": "./src/evals/index.ts",
    "./testing": "./src/testing/fixtures.ts",
    "./testing/scripted-thread": "./src/testing/scripted-thread.ts",
    "./testing/tool-refresh-probe": "./src/testing/tool-refresh-probe.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval-viewer && tsc --noEmit -p eval-viewer/server",
    "test": "bun test",
    "spike": "bun src/spike-run.ts",
    "demo": "bun src/demo-run.ts",
    "repl": "bun src/repl-run.ts",
    "eval:agent": "bun src/eval-run.ts",
    "eval:all": "bun src/eval-all-run.ts",
    "eval:rescore": "bun src/eval-rescore-run.ts",
    "eval:review": "bun src/eval-review-run.ts",
    "eval:digests": "bun src/eval-digests-run.ts",
    "eval:classify": "bun src/eval-classify-run.ts",
    "eval:reading": "bun src/eval-run.ts reading",
    "eval:behavior": "bun src/eval-run.ts behavior",
    "eval:realbook": "bun src/eval-run.ts realbook",
    "eval:ui": "vite --config eval-viewer/vite.config.ts --port 5199",
    "lint:deps": "bun ../../scripts/check-dependency-baseline.ts",
    "lint:deps:baseline": "bun ../../scripts/check-dependency-baseline.ts --update"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@read-aware/core": "workspace:*"
  },
  "devDependencies": {
    "@read-aware/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dependency-cruiser": "^18.7.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7"
  }
}
