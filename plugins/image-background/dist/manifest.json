{
  "id": "image-background",
  "name": "Image Background",
  "version": "1.0.0",
  "schemaVersion": 1,
  "minAppVersion": "0.6.7",
  "description": "Use a local image as your reading background and adjust its opacity and dimming. Images stay on this device.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": [
    "ui:themes"
  ],
  "settingsAccess": {
    "read": [
      "reading.theme"
    ],
    "write": [
      "reading.theme"
    ]
  },
  "requires": {
    "domains": {
      "settings": "^1.2.0"
    },
    "contributions": {
      "themes": "^1.1.0",
      "headerActions": "^1.0.0",
      "commands": "^1.0.0"
    },
    "services": {
      "resources": "^1.6.0",
      "storage": "^2.1.0"
    },
    "schemas": {
      "views": "^1.0.0"
    }
  }
}
