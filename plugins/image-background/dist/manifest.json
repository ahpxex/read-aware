{
  "id": "image-background",
  "name": "Image Background",
  "version": "1.3.0",
  "schemaVersion": 1,
  "minAppVersion": "0.6.7",
  "description": "Create reading themes from a base theme and a local background image. Adjust opacity and dimming, then select your theme here or in Reading settings.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": [
    "ui:themes"
  ],
  "requires": {
    "contributions": {
      "themes": "^1.2.0",
      "commands": "^1.0.0",
      "settingsPage": "^1.0.0"
    },
    "services": {
      "resources": "^1.6.0",
      "storage": "^2.1.0",
      "ui": "^1.2.0"
    },
    "schemas": {
      "views": "^1.7.0"
    },
    "domains": {
      "settings": "^1.6.0"
    }
  },
  "settingsAccess": {
    "read": [
      "reading.theme"
    ],
    "write": [
      "reading.theme"
    ]
  }
}
