{
  "id": "jumper",
  "name": "Jumper",
  "version": "0.13.1",
  "schemaVersion": 1,
  "minAppVersion": "0.3.0",
  "description": "Jump to a chapter, page or passage in the open book from one search box, and keep named bookmarks.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": [
    "library:read",
    "reading:write",
    "agent:tools"
  ],
  "requires": {
    "domains": {
      "library": "^1.17.0",
      "reading": "^2.22.0"
    },
    "contributions": {
      "headerActions": "^1.1.0",
      "commands": "^1.1.0",
      "agentTools": "^1.2.0"
    },
    "services": {
      "plugins": "^1.9.0",
      "ui": "^1.2.0",
      "storage": "^2.3.0"
    },
    "schemas": {
      "views": "^1.12.0"
    }
  },
  "services": [
    {
      "id": "bookmark-page",
      "version": "1.0.0",
      "title": "Book bookmarks",
      "description": "Read a page of saved bookmark names for the authorized book.",
      "scope": "book",
      "permissions": [
        "library:read"
      ],
      "input": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 8192
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "stale-cursor"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 1024
                },
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "location",
                    "selection"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    }
  ]
}
