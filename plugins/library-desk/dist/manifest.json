{
  "id": "library-desk",
  "name": "Library Desk",
  "version": "0.6.0",
  "schemaVersion": 1,
  "description": "Navigate collections and app surfaces, show selected books on the shelf, review removal batches, and retry file cleanup.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": ["library:write", "reading:write"],
  "settingsAccess": { "read": ["shelf.layout", "shelf.sort", "shelf.group"], "write": ["shelf.layout", "shelf.sort", "shelf.group"] },
  "requires": {
    "domains": { "library": "^1.6.0", "reading": "^2.0.0" },
    "contributions": { "headerActions": "^1.0.0", "commands": "^1.0.0" },
    "services": { "ui": "^1.6.0" },
    "schemas": { "views": "^1.2.0" }
  }
}
