{
  "id": "reading-goals",
  "name": "Reading Goals",
  "version": "0.4.0",
  "schemaVersion": 2,
  "minAppVersion": "0.3.0",
  "description": "Book-specific reading goals, conversation context and opt-in memory suggestions.",
