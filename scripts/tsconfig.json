{
  "extends": "../packages/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "moduleDetection": "force"
  },
  "include": ["**/*.ts"],
  // The capability audit imports app internals; check:capabilities typechecks it
  // through tsconfig.capabilities.json so refactors do not fail the CI typecheck.
  "exclude": ["build-host-capability-*.ts", "check-capabilities*.ts", "host-capability-*.ts"]
}
